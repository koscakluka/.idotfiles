# Font
font-family = DejaVuSansM Nerd Font Mono
font-style = Regular
font-family-bold = DejaVuSansM Nerd Font Mono
font-style-bold = Bold

# Terminal behavior
term = xterm-256color
mouse-scroll-multiplier = 8

# Window
background-opacity = 0.98
window-decoration = none
window-theme = dark
window-padding-x = 6
window-padding-y = 6

# Iron Neon
background = #0A0B0E
foreground = #CDD3DA
cursor-color = #CDD3DA
cursor-text = #0A0B0E
selection-foreground = #CDD3DA
selection-background = #1B1F27
search-foreground = #0A0B0E
search-background = #C9A85A
search-selected-foreground = #0A0B0E
search-selected-background = #FF4D5A

palette = 0=#101217
palette = 1=#D24A57
palette = 2=#7FAD86
palette = 3=#C9A85A
palette = 4=#6F8FC9
palette = 5=#B388D6
palette = 6=#6FB6C2
palette = 7=#B8C0CA
palette = 8=#2A303A
palette = 9=#FF4D5A
palette = 10=#9AD0A3
palette = 11=#E0C57B
palette = 12=#8FB0EA
palette = 13=#D0A6F0
palette = 14=#89D3DE
palette = 15=#E8EDF3
