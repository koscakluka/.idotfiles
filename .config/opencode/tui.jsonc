{
  "$schema": "https://opencode.ai/tui.json",
  "attention": {
    "enabled": true,
    // Keep native question and permission sounds; silence other events.
    "sounds": {
      "default": "./silence.wav",
      "done": "./silence.wav",
      "error": "./silence.wav",
      "subagent_done": "./silence.wav"
    }
  },
  "keybinds": {
    "session_list": "none"
  },
  "plugin": ["./plugins/session-complete", "./plugins/session-auto-rename"]
}
